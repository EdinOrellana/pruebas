{
  "name": "cpx-cheque-backend",
  "version": "1.0.0",
  "description": "Backend Cheques - Express + TypeORM + Oracle (PKG_CHEQUE)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typeorm",
    "oracle",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "oracledb": "^6.10.0",
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/oracledb": "^6.10.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "oracledb@6.10.0": true
  }
}
